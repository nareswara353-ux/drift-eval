<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>drift-eval report</title>
<style>
*{box-sizing:border-box}
body{font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;margin:0;padding:2rem;background:#fafafa;color:#1a1a1a}
header{margin-bottom:1.5rem;padding-bottom:1rem;border-bottom:2px solid #e5e5e5}
h1{margin:0 0 .5rem 0;font-size:1.6rem}
h2{margin:1.5rem 0 .75rem 0;font-size:1.15rem;color:#333}
.meta{color:#666;font-size:.875rem;margin:.25rem 0}
.badge{display:inline-block;padding:.2rem .6rem;border-radius:999px;font-size:.75rem;font-weight:600;letter-spacing:.02em}
.badge.drifted{background:#fee;color:#b00020}
.badge.stable{background:#e6f7ee;color:#0a7c3a}
.badge.inconclusive{background:#fff7e0;color:#8a6d00}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;margin:1rem 0}
.card{background:#fff;border:1px solid #e5e5e5;border-radius:8px;padding:1rem}
.card .label{font-size:.75rem;text-transform:uppercase;color:#777;letter-spacing:.05em}
.card .value{font-size:1.5rem;font-weight:700;margin-top:.25rem}
table{border-collapse:collapse;width:100%;background:#fff;border:1px solid #e5e5e5;border-radius:8px;overflow:hidden}
thead{background:#f0f0f0}
th,td{padding:.65rem .75rem;text-align:left;font-size:.875rem;border-bottom:1px solid #eee}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover{background:#fafafa}
.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.8rem}
footer{margin-top:2rem;color:#999;font-size:.75rem;text-align:center}
</style>
</head>
<body>
<header>
<h1>Distribution Drift Report</h1>
<p class="meta">Reference column: <strong>{{ reference_column }}</strong></p>
<p class="meta">Target column: <strong>{{ target_column }}</strong></p>
<p class="meta">Significance alpha: <strong>{{ alpha }}</strong></p>
</header>

<section class="cards">
<div class="card"><div class="label">Drifted Metrics</div><div class="value">{{ drifted_count }}</div></div>
<div class="card"><div class="label">Total Metrics</div><div class="value">{{ total }}</div></div>
<div class="card"><div class="label">Total Duration</div><div class="value">{{ total_millis }} ms</div></div>
</section>

<h2>Metric Outcomes</h2>
<table>
<thead>
<tr>
<th>Metric</th>
<th>Statistic</th>
<th>P-Value</th>
<th>Critical</th>
<th>Verdict</th>
<th>N (ref / tgt)</th>
</tr>
</thead>
<tbody>
{% for outcome in outcomes %}
<tr>
<td>{{ outcome.metric }}</td>
<td class="mono">{{ outcome.statistic }}</td>
<td class="mono">{% if outcome.p_value is defined and outcome.p_value is not none %}{{ outcome.p_value }}{% else %}-{% endif %}</td>
<td class="mono">{{ outcome.critical }}</td>
<td><span class="badge {{ outcome.verdict }}">{{ outcome.verdict }}</span></td>
<td class="mono">{{ outcome.sample_size_reference }} / {{ outcome.sample_size_target }}</td>
</tr>
{% endfor %}
</tbody>
</table>

<footer>Generated by drift-eval</footer>
</body>
</html>
